+package com.oney.WebRTCModule;
+
+import android.content.Context;
+import android.graphics.Point;
+import android.graphics.SurfaceTexture;
+import android.graphics.drawable.Drawable;
+import android.util.AttributeSet;
+import android.view.TextureView;
+
+import org.webrtc.EglBase;
+import org.webrtc.EglRenderer;
+import org.webrtc.GlRectDrawer;
+import org.webrtc.RendererCommon;
+import org.webrtc.RendererCommon.RendererEvents;
+import org.webrtc.ThreadUtils;
+import org.webrtc.VideoFrame;
+import org.webrtc.VideoSink;
+
+import java.util.concurrent.CountDownLatch;
+
+/**
+ * Speakeasy addition: a TextureView-backed WebRTC video renderer, a drop-in for
+ * org.webrtc.SurfaceViewRenderer inside {@link WebRTCView}.
+ *
+ * WHY: react-native-webrtc renders into a SurfaceViewRenderer. A SurfaceView's
+ * underlying buffer does NOT reliably track the view size when the SYSTEM
+ * resizes the window — which is exactly what Android Picture-in-Picture does as
+ * the bubble grows/shrinks. The result was a video call bubble that showed the
+ * frame at a fixed size (overflowing the small bubble as a cropped corner, or
+ * under-filling the enlarged bubble with a black band). A TextureView renders
+ * into the view's own hardware layer, so its content always matches the view
+ * bounds — it resizes cleanly in PiP. Same approach LiveKit/GetStream default to.
+ *
+ * Mirrors org.webrtc's SurfaceViewRenderer + SurfaceEglRenderer against the same
+ * EglRenderer API (every call here is present in org.jitsi:webrtc 124): an
+ * EglRenderer does the GL drawing; we feed it the TextureView's SurfaceTexture
+ * on availability and release it on destroy, and forward frames via VideoSink.
+ * Only the public methods WebRTCView calls are implemented; SurfaceView-only
+ * z-order controls are inert no-ops, and setBackground* are swallowed (a
+ * TextureView THROWS UnsupportedOperationException on any background drawable —
+ * WebRTCView sets a black/transparent idle background, and the video fills the
+ * opaque view anyway, so the background is moot).
+ */
+public class TextureViewRenderer extends TextureView
+        implements VideoSink, TextureView.SurfaceTextureListener {
+
+    private final EglRenderer eglRenderer;
+    private final RendererCommon.VideoLayoutMeasure videoLayoutMeasure =
+            new RendererCommon.VideoLayoutMeasure();
+    private final Object layoutLock = new Object();
+
+    private RendererEvents rendererEvents;
+    private boolean isFirstFrameRendered;
+    private int rotatedFrameWidth;
+    private int rotatedFrameHeight;
+    private int frameRotation;
+
+    public TextureViewRenderer(Context context) {
+        super(context);
+        this.eglRenderer = new EglRenderer("TextureViewRenderer");
+        setSurfaceTextureListener(this);
+    }
+
+    public TextureViewRenderer(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        this.eglRenderer = new EglRenderer("TextureViewRenderer");
+        setSurfaceTextureListener(this);
+    }
+
+    /** Matches SurfaceViewRenderer#init(EglBase.Context, RendererEvents). */
+    public void init(EglBase.Context sharedContext, RendererEvents events) {
+        ThreadUtils.checkIsOnMainThread();
+        this.rendererEvents = events;
+        synchronized (layoutLock) {
+            isFirstFrameRendered = false;
+            rotatedFrameWidth = 0;
+            rotatedFrameHeight = 0;
+            frameRotation = 0;
+        }
+        eglRenderer.init(sharedContext, EglBase.CONFIG_PLAIN, new GlRectDrawer());
+    }
+
+    public void release() {
+        eglRenderer.release();
+    }
+
+    public void setScalingType(RendererCommon.ScalingType scalingType) {
+        ThreadUtils.checkIsOnMainThread();
+        synchronized (layoutLock) {
+            videoLayoutMeasure.setScalingType(scalingType);
+        }
+        requestLayout();
+    }
+
+    public void setMirror(boolean mirror) {
+        eglRenderer.setMirror(mirror);
+    }
+
+    public void clearImage() {
+        eglRenderer.clearImage();
+    }
+
+    // A TextureView THROWS UnsupportedOperationException on any background
+    // drawable (setBackgroundColor -> setBackground -> setBackgroundDrawable).
+    // WebRTCView calls setBackgroundColor(BLACK/TRANSPARENT) for its idle
+    // "clean" state — swallow both so it doesn't crash. The view is opaque and
+    // the video fills it, so a background would never be visible anyway.
+    @Override
+    public void setBackgroundColor(int color) {
+        // no-op
+    }
+
+    @Override
+    public void setBackground(Drawable background) {
+        // no-op
+    }
+
+    // SurfaceView-only z-order controls WebRTCView calls — inert on a TextureView.
+    public void setZOrderMediaOverlay(boolean isMediaOverlay) {}
+
+    public void setZOrderOnTop(boolean onTop) {}
+
+    // ---- VideoSink ----------------------------------------------------------
+
+    @Override
+    public void onFrame(VideoFrame frame) {
+        updateFrameDimensionsAndReportEvents(frame);
+        eglRenderer.onFrame(frame);
+    }
+
+    // ---- TextureView.SurfaceTextureListener ---------------------------------
+
+    @Override
+    public void onSurfaceTextureAvailable(SurfaceTexture surfaceTexture, int width, int height) {
+        ThreadUtils.checkIsOnMainThread();
+        eglRenderer.createEglSurface(surfaceTexture);
+    }
+
+    @Override
+    public void onSurfaceTextureSizeChanged(SurfaceTexture surfaceTexture, int width, int height) {
+        // Intentionally a no-op. TextureView already calls
+        // SurfaceTexture#setDefaultBufferSize(w,h) on resize, so new buffers come
+        // out at the new size and the EGL surface tracks it. (An earlier attempt
+        // to release+recreate the EGL surface here CRASHED: createEglSurface
+        // races the SurfaceTexture teardown during call-close/reopen —
+        // "GLException: Failed to create window surface" on EglThread.)
+    }
+
+    @Override
+    public boolean onSurfaceTextureDestroyed(SurfaceTexture surfaceTexture) {
+        ThreadUtils.checkIsOnMainThread();
+        final CountDownLatch completionLatch = new CountDownLatch(1);
+        eglRenderer.releaseEglSurface(completionLatch::countDown);
+        ThreadUtils.awaitUninterruptibly(completionLatch);
+        return true;
+    }
+
+    @Override
+    public void onSurfaceTextureUpdated(SurfaceTexture surfaceTexture) {}
+
+    // ---- View layout --------------------------------------------------------
+
+    @Override
+    protected void onMeasure(int widthSpec, int heightSpec) {
+        ThreadUtils.checkIsOnMainThread();
+        // Always take the full available size. WebRTCView positions us (fill, for
+        // cover) via a direct layout() call, so letting videoLayoutMeasure impose
+        // a fit-size here just fought that and contributed to the letterboxed
+        // bubble. The EglRenderer does the cover crop via setLayoutAspectRatio.
+        setMeasuredDimension(
+                getDefaultSize(getSuggestedMinimumWidth(), widthSpec),
+                getDefaultSize(getSuggestedMinimumHeight(), heightSpec));
+    }
+
+    @Override
+    protected void onLayout(boolean changed, int left, int top, int right, int bottom) {
+        ThreadUtils.checkIsOnMainThread();
+        eglRenderer.setLayoutAspectRatio((right - left) / (float) (bottom - top));
+    }
+
+    private void updateFrameDimensionsAndReportEvents(VideoFrame frame) {
+        synchronized (layoutLock) {
+            if (!isFirstFrameRendered) {
+                isFirstFrameRendered = true;
+                if (rendererEvents != null) {
+                    rendererEvents.onFirstFrameRendered();
+                }
+            }
+            if (rotatedFrameWidth != frame.getRotatedWidth()
+                    || rotatedFrameHeight != frame.getRotatedHeight()
+                    || frameRotation != frame.getRotation()) {
+                rotatedFrameWidth = frame.getRotatedWidth();
+                rotatedFrameHeight = frame.getRotatedHeight();
+                frameRotation = frame.getRotation();
+                if (rendererEvents != null) {
+                    rendererEvents.onFrameResolutionChanged(
+                            frame.getBuffer().getWidth(), frame.getBuffer().getHeight(), frameRotation);
+                }
+                // Re-measure/-layout on the UI thread when the frame geometry changes.
+                post(this::requestLayout);
+            }
+        }
+    }
+}
