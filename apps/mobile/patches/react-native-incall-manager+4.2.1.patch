+    // Speakeasy diagnostic beta: metadata-only focus/route truth. Null means the
+    // platform cannot provide a field; never turn missing state into a false zero.
+    private void emitSpeakeasyAudioDiagnostics(String event, @Nullable String focusResult,
+            @Nullable String requestedDevice) {
+        WritableMap data = Arguments.createMap();
+        data.putString("event", event);
+        data.putBoolean("important", true);
+        data.putDouble("nativeElapsedMs", android.os.SystemClock.elapsedRealtime());
+        if (focusResult == null || focusResult.isEmpty()) data.putNull("focusResult");
+        else data.putString("focusResult", focusResult);
+        // Speakeasy: for "route selected"/"route select dropped" this is the
+        // device the caller asked for at the decision moment; null elsewhere.
+        if (requestedDevice == null) data.putNull("requestedDevice");
+        else data.putString("requestedDevice", requestedDevice);
+        data.putInt("mode", audioManager.getMode());
+        data.putBoolean("microphoneMuted", audioManager.isMicrophoneMute());
+        data.putBoolean("speakerphoneOn", audioManager.isSpeakerphoneOn());
+        if (selectedAudioDevice == null) data.putNull("selectedAudioDevice");
+        else data.putString("selectedAudioDevice", selectedAudioDevice.name());
+        data.putString("availableAudioDevices", audioDevices.toString());
+        Activity activity = getCurrentActivity();
+        if (activity == null) data.putNull("appTopmost");
+        else data.putBoolean("appTopmost", activity.hasWindowFocus());
+        // This library does not own the app's FGS and cannot inspect its declared type.
+        data.putNull("microphoneForegroundService");
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            AudioDeviceInfo device = audioManager.getCommunicationDevice();
+            if (device == null) data.putNull("effectiveCommunicationDeviceType");
+            else data.putInt("effectiveCommunicationDeviceType", device.getType());
+        } else {
+            data.putNull("effectiveCommunicationDeviceType");
+        }
+        sendEvent("SpeakeasyAudioFocusDiagnostics", data);
+    }
