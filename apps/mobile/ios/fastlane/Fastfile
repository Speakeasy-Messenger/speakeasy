# Speakeasy iOS — fastlane lanes.
#
# Auth: App Store Connect API key (no Apple ID password / 2FA). The key
# parts are injected via env (sourced from the squire vault locally, and
# from GitHub Actions secrets in CI):
#   ASC_KEY_ID            — the key id (e.g. YJV2ZFM84L)
#   ASC_ISSUER_ID         — the issuer UUID
#   ASC_KEY_CONTENT       — the .p8 private key contents (PEM, with newlines)
#   ASC_KEY_CONTENT_BASE64 — "true" if ASC_KEY_CONTENT is base64-encoded
# Signing: fastlane match (git storage — Speakeasy-Messenger/speakeasy-certs),
#   unlocked with MATCH_PASSWORD.
#
# Pods must be installed first (USE_FRAMEWORKS=static — LibSignalClient is a
# Swift pod). The CI workflow + the `pods` lane handle that.

default_platform(:ios)

APP_IDENTIFIER = "xyz.speakeasyapp.app".freeze
WORKSPACE = "Speakeasy.xcworkspace".freeze
SCHEME = "Speakeasy".freeze
TEAM_ID = "89KT3SWYAF".freeze
PROFILE = "match AppStore #{APP_IDENTIFIER}".freeze
# Share Extension target — its own bundle id + match profile (App Group).
EXT_IDENTIFIER = "xyz.speakeasyapp.app.ShareExtension".freeze
EXT_PROFILE = "match AppStore #{EXT_IDENTIFIER}".freeze
# Notification Service Extension — own bundle id + match profile (App Group,
# for the shared SQLCipher store the rich-push decrypt reads).
NSE_IDENTIFIER = "xyz.speakeasyapp.app.NotificationService".freeze
NSE_PROFILE = "match AppStore #{NSE_IDENTIFIER}".freeze

# Cancels a review submission that is stuck in UNRESOLVED_ISSUES (Apple will
# not accept new items on one, so submit_for_review on it always fails with
# "Version is not ready to be submitted yet"), waits for the cancellation to
# settle, and returns a FRESH submission the version can be added to.
#
# Verified against the vendored fastlane 2.239 spaceship source:
# - ReviewSubmission#cancel_submission exists (PATCH reviewSubmissions/{id}
#   with canceled: true) — the only first-class reset the gem offers.
# - ReviewSubmission#delete! and ReviewSubmissionItem#delete/delete! do NOT
#   exist in fastlane 2.239; the item-delete fallback below goes through the
#   raw Tunes request client (DELETE v1/reviewSubmissionItems/{id}).
# - ReviewSubmissionItem.all(review_submission_id:) exists (class method,
#   paginates via get_review_submission_items).
def cancel_review_submission(submission)
  cancelled = submission.cancel_submission
  UI.success("Cancelled review submission id=#{submission.id} state=#{cancelled&.state}")
  true
rescue => e
  UI.important("cancel_submission on id=#{submission.id} failed (#{e.class}: #{e.message[0, 160]})")
  false
end

def reset_unresolved_submission!(app:, submission:)
  old_id = submission.id
  UI.message("Resetting review submission id=#{old_id} state=#{submission.state} (UNRESOLVED_ISSUES)")
  unless cancel_review_submission(submission)
    UI.important("Falling back to removing the items of submission id=#{old_id}")
    items = (Array(submission.items) rescue [])
    begin
      items = Spaceship::ConnectAPI::ReviewSubmissionItem.all(review_submission_id: old_id) if items.empty?
      client = Spaceship::ConnectAPI.client
      items.each do |item|
        client.tunes_request_client.delete("v1/reviewSubmissionItems/#{item.id}")
        UI.success("Deleted review submission item id=#{item.id}")
      end
    rescue => e2
      UI.user_error!("Could not cancel submission #{old_id} nor delete its items: #{e2.class}: #{e2.message[0, 200]}")
    end
    UI.message("Retrying cancel_submission on the now-empty submission id=#{old_id}")
    cancel_review_submission(submission)
  end

  # Cancellation is asynchronous on ASC: the submission reports CANCELING (which
  # get_in_progress_review_submission does NOT match) while the version is still
  # attached to it. Poll the submission itself until it leaves every open state
  # (or disappears), then create the fresh one.
  states = Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState
  open_states = [states::CANCELING, states::UNRESOLVED_ISSUES, states::WAITING_FOR_REVIEW,
                 states::IN_REVIEW, states::READY_FOR_REVIEW]
  deadline = Time.now + 180
  last_state = submission.state
  settled = false
  while Time.now < deadline
    begin
      current = Spaceship::ConnectAPI::ReviewSubmission.get(review_submission_id: old_id)
      last_state = current&.state
      unless open_states.include?(last_state)
        UI.success("Review submission id=#{old_id} settled with state=#{last_state.inspect}")
        settled = true
        break
      end
    rescue Spaceship::UnexpectedResponse => e
      UI.success("Review submission id=#{old_id} can no longer be fetched (#{e.message[0, 160]}) — treating as settled")
      settled = true
      break
    end
    UI.message("Waiting for ASC to release submission id=#{old_id} (state=#{last_state})...")
    sleep(15)
  end
  unless settled
    UI.user_error!(
      "Review submission id=#{old_id} is still open (state=#{last_state}) after waiting 180s " \
      "for the cancellation to settle. Not creating a new submission on top of it — " \
      "wait a few minutes and re-run with reset_submission=true."
    )
  end

  fresh = app.create_review_submission(platform: "IOS")
  UI.success("Created NEW review submission id=#{fresh.id} state=#{fresh.state}")
  return fresh
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: ENV["ASC_KEY_CONTENT_BASE64"] == "true",
    in_house: false,
  )
end

# Pin manual signing + the match profile on the app target at build time,
# so we never depend on whatever signing the checked-in pbxproj happens to
# carry. Ephemeral on CI; on a dev Mac it edits the project — `git checkout`
# the pbxproj afterward if you don't want the change.
def pin_signing
  update_code_signing_settings(
    path: "Speakeasy.xcodeproj",
    use_automatic_signing: false,
    team_id: TEAM_ID,
    bundle_identifier: APP_IDENTIFIER,
    code_sign_identity: "Apple Distribution",
    profile_name: PROFILE,
    targets: ["Speakeasy"],
  )
  # Same, for the Share Extension target (its own bundle id + profile).
  update_code_signing_settings(
    path: "Speakeasy.xcodeproj",
    use_automatic_signing: false,
    team_id: TEAM_ID,
    bundle_identifier: EXT_IDENTIFIER,
    code_sign_identity: "Apple Distribution",
    profile_name: EXT_PROFILE,
    targets: ["ShareExtension"],
  )
  # Same, for the Notification Service Extension.
  update_code_signing_settings(
    path: "Speakeasy.xcodeproj",
    use_automatic_signing: false,
    team_id: TEAM_ID,
    bundle_identifier: NSE_IDENTIFIER,
    code_sign_identity: "Apple Distribution",
    profile_name: NSE_PROFILE,
    targets: ["NotificationService"],
  )
end

# TestFlight/App Store reject a build whose CFBundleVersion (build number)
# collides with one already uploaded for the same CFBundleShortVersionString.
# The Android side derives versionCode from the git tag; iOS has no such
# derivation, so set the build number from a monotonic CI counter
# (BUILD_NUMBER env = github.run_id). No-op for a local run that doesn't
# set it — you'd bump manually or let Xcode's value stand.
def set_ci_build_number
  bn = ENV["BUILD_NUMBER"]
  return if bn.nil? || bn.empty?
  increment_build_number(xcodeproj: "Speakeasy.xcodeproj", build_number: bn)
end

# Spaceship token from the same ASC API key env the rest of the lane uses,
# so we can talk to App Store Connect directly (list beta groups).
def asc_token
  require "spaceship"
  require "base64"
  content = ENV.fetch("ASC_KEY_CONTENT")
  content = Base64.decode64(content) if ENV["ASC_KEY_CONTENT_BASE64"] == "true"
  Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key: content,
  )
end

# Which external TestFlight groups to auto-release each beta build to.
# The lane uploaded builds but NEVER released them to external testers
# (distribute_external was false, no groups) — so external testers only
# ever saw builds someone released BY HAND in App Store Connect, and went
# stale the moment nobody did that step. Fix it without hardcoding a group
# name (which isn't in the repo and which CI can't be told out-of-band):
# ask App Store Connect, at release time, for every EXTERNAL group on the
# app and release to all of them. `TESTFLIGHT_EXTERNAL_GROUPS` (comma-sep)
# overrides if ever needed. Failure is non-fatal — we fall back to the old
# upload-only behavior so a release can never be WORSE than before.
def external_beta_group_names
  override = (ENV["TESTFLIGHT_EXTERNAL_GROUPS"] || "").split(",").map(&:strip).reject(&:empty?)
  return override unless override.empty?
  Spaceship::ConnectAPI.token = asc_token
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  names = app.get_beta_groups.reject(&:is_internal_group).map(&:name)
  UI.message("External TestFlight groups discovered: #{names.inspect}")
  names
rescue => e
  UI.important("Could not list external beta groups (#{e.message}); uploading without external distribution.")
  []
end

platform :ios do
  desc "Install CocoaPods (USE_FRAMEWORKS=static for the LibSignalClient Swift pod)"
  lane :pods do
    sh("cd .. && USE_FRAMEWORKS=static pod install")
  end

  desc "Create/refresh the App Store signing cert + profiles via match. Run " \
       "locally OR via the ios-certs.yml workflow_dispatch (needs a WRITE " \
       "deploy key). Regenerates a profile per app_identifier in the Matchfile."
  lane :certs do
    # Unlocked keychain for non-interactive cert install (CI / SSH).
    setup_ci(force: true)
    # force: true regenerates the profiles even if a valid one already exists —
    # required to pick up a NEWLY-enabled App-ID capability (match reuses an
    # existing valid profile otherwise, so a new entitlement like
    # multitasking-camera-access would never make it into the profile).
    match(type: "appstore", readonly: false, force: true, api_key: asc_api_key)
  end

  desc "Sync signing (read-only — for CI, after `certs` has populated the repo)"
  lane :signing do
    match(type: "appstore", readonly: true, api_key: asc_api_key)
  end

  desc "Build a signed, non-uploaded IPA that boots the video/PiP harness"
  lane :browserstack do
    setup_ci(force: true)
    key = asc_api_key
    match(type: "appstore", readonly: is_ci, api_key: key)
    pin_signing
    set_ci_build_number
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_IDENTIFIER => PROFILE, EXT_IDENTIFIER => EXT_PROFILE, NSE_IDENTIFIER => NSE_PROFILE } },
      output_directory: "build",
      output_name: "Speakeasy-BrowserStack.ipa",
      clean: true,
      xcargs: 'SPEAKEASY_VIDEO_CALL_HARNESS_ENABLED=1',
    )
  end

  desc "Build a signed TestFlight IPA without uploading it"
  lane :build_beta do
    # Create a dedicated, unlocked keychain with the signing key's partition
    # list set for NON-INTERACTIVE codesign. Without this, codesign blocks on
    # a GUI "allow access" prompt that never comes — on a CI runner it hangs
    # until the job timeout; over SSH it fails with errSecInternalComponent.
    setup_ci(force: true)
    key = asc_api_key
    match(type: "appstore", readonly: is_ci, api_key: key)
    pin_signing
    set_ci_build_number
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_IDENTIFIER => PROFILE, EXT_IDENTIFIER => EXT_PROFILE, NSE_IDENTIFIER => NSE_PROFILE } },
      output_directory: "build",
      output_name: "Speakeasy.ipa",
      clean: true,
    )
  end

  desc "Upload an already-built IPA to TestFlight and distribute it"
  lane :upload_beta do
    key = asc_api_key
    groups = external_beta_group_names
    distribute = !groups.empty?
    upload_to_testflight(
      api_key: key,
      ipa: ENV["IPA_PATH"] || "build/Speakeasy.ipa",
      # Auto-release to every external group (so testers actually get the
      # build — that release step used to be manual and was the real reason
      # builds went stale). Releasing REQUIRES a processed build, so we wait
      # only when we're distributing; with no groups we keep the old fast
      # upload-and-go. Builds on an already-approved version skip Apple's
      # beta review and reach testers in minutes; the first build of a NEW
      # version waits ~24h for review (a reason to keep the version stable).
      distribute_external: distribute,
      groups: distribute ? groups : nil,
      notify_external_testers: distribute,
      skip_waiting_for_build_processing: !distribute,
      # Apple requires a "what's new" note for any externally-distributed
      # build. Generic default keeps the release unblocked; override per
      # release with TESTFLIGHT_CHANGELOG.
      changelog: distribute ? (ENV["TESTFLIGHT_CHANGELOG"] || "Bug fixes and improvements.") : nil,
    )
  end

  desc "Build + upload to TestFlight"
  lane :beta do
    build_beta
    upload_beta
  end

  desc "Add an ALREADY-UPLOADED, processed TestFlight build to the external " \
       "tester group. No build, no signing — pure ASC API. Recovery path for " \
       "builds uploaded before the beta lane distributed automatically. " \
       "Env: DIST_BUILD_NUMBER (required), DIST_APP_VERSION (default 1.0), " \
       "TESTFLIGHT_GROUP (default Friends)."
  lane :distribute do
    upload_to_testflight(
      api_key: asc_api_key,
      distribute_only: true,
      app_platform: "ios", # distribute_only can't infer it from an ipa — prompts without this
      app_version: ENV["DIST_APP_VERSION"] || "1.0",
      build_number: ENV.fetch("DIST_BUILD_NUMBER"),
      distribute_external: true,
      groups: [ENV["TESTFLIGHT_GROUP"] || "Friends"],
      changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Bug fixes and improvements.",
    )
  end

  desc "Build + upload to the App Store (NOT auto-submitted for review)"
  lane :release do
    setup_ci(force: true) # non-interactive codesign keychain — see beta lane.
    key = asc_api_key
    match(type: "appstore", readonly: is_ci, api_key: key)
    pin_signing
    set_ci_build_number
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_IDENTIFIER => PROFILE, EXT_IDENTIFIER => EXT_PROFILE, NSE_IDENTIFIER => NSE_PROFILE } },
      output_directory: "build",
      output_name: "Speakeasy.ipa",
      clean: true,
    )
    upload_to_app_store(
      api_key: key,
      submit_for_review: false, # flip to true once the listing is review-ready
      force: true, # skip the HTML metadata preview prompt
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Push App Store listing metadata + screenshots only (no binary). " \
       "iOS analog of play-listing.yml. Reads fastlane/metadata/<locale>/ " \
       "+ fastlane/screenshots/<locale>/."
  lane :listing do
    upload_to_app_store(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: false,
      # Screenshots are heavy + change rarely; toggle with SKIP_SCREENSHOTS=true
      # (e.g. before any captures exist) so a metadata-only push still works.
      skip_screenshots: ENV["SKIP_SCREENSHOTS"] == "true",
      overwrite_screenshots: true,
      primary_category: "SOCIAL_NETWORKING",
      force: true, # no interactive HTML preview
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Attach an ALREADY-UPLOADED build to the editable App Store version " \
       "and submit it for review — no binary build, talks to ASC only. For " \
       "resubmitting after a rejection when the build picker can't be reached " \
       "(e.g. App Store Connect on mobile). Build number via SUBMIT_BUILD_NUMBER."
  lane :submit_build do
    require "spaceship"
    require "base64"
    # Self-contained ASC token (don't depend on other Fastfile helpers that
    # may not exist on whatever branch the workflow runs from).
    asc_key = ENV.fetch("ASC_KEY_CONTENT")
    asc_key = Base64.decode64(asc_key) if ENV["ASC_KEY_CONTENT_BASE64"] == "true"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: asc_key,
    )
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.message("App id=#{app.id} (#{APP_IDENTIFIER})")

    # Print every version + its state so we can see what's actually editable
    # (deliver's submit couldn't find an 'editable version' — diagnose why).
    versions = app.get_app_store_versions(includes: "appStoreVersionSubmission")
    versions.each do |v|
      UI.message("VERSION #{v.version_string} platform=#{v.platform} state=#{v.app_store_state} id=#{v.id}")
    end

    # Read-only mode: report state and touch nothing. Safe to run against a
    # version that is already in review.
    if ENV["STATUS_ONLY"] == "true"
      # Re-fetch WITH the relationships: without includes, `build` and the
      # review detail come back nil and look like "nothing is set" when they
      # are in fact set. Report the fetch failing separately from it being empty.
      detailed = app.get_app_store_versions(includes: "build,appStoreReviewDetail")
      detailed.each do |v|
        UI.message("  version=#{v.version_string} state=#{v.app_store_state}")
        b = (v.build rescue nil)
        UI.message("  attached_build=#{b ? b.version : 'NONE'}")
        begin
          d = v.app_store_review_detail
          UI.message("  notes_len=#{(d&.notes || '').length}")
          UI.message("  notes_has_video_link=#{(d&.notes || '').include?('drive.google.com')}")
        rescue => e
          UI.important("  review-detail fetch FAILED (#{e.class}) — cannot read notes")
        end
      end
      sub = app.get_in_progress_review_submission(platform: "IOS")
      UI.message("in_progress_review_submission=#{sub ? "id=#{sub.id} state=#{sub.state}" : 'none'}")
      next
    end

    # Diagnose why ASC calls a version "not in valid state", and clear any empty
    # review submission a failed attempt left behind (an orphan blocks the UI).
    if ENV["DIAGNOSE"] == "true"
      v = app.get_app_store_versions(includes: "build,appStoreReviewDetail,appStoreVersionLocalizations")
             .find { |x| x.version_string == ENV.fetch("APP_VERSION", "1.0") }
      UI.message("version=#{v.version_string} state=#{v.app_store_state} release_type=#{v.release_type}")
      b = (v.build rescue nil)
      UI.message("build=#{b&.version} processing=#{b&.processing_state} expired=#{b&.expired}")
      begin
        ec = Spaceship::ConnectAPI.get_build(build_id: b.id, includes: "buildBetaDetail")
        UI.message("build_raw=#{ec.to_models.first.uses_non_exempt_encryption.inspect} (nil = export compliance UNANSWERED)")
      rescue => e
        UI.important("export-compliance read failed: #{e.message[0,120]}")
      end
      begin
        ar = app.fetch_age_rating_declaration
        UI.message("age_rating_declaration=#{ar ? 'present' : 'MISSING'}")
      rescue => e
        UI.important("age rating read failed: #{e.message[0,120]}")
      end
      UI.message("content_rights=#{(app.content_rights_declaration rescue 'unreadable')}")
      v.get_app_store_version_localizations.each do |loc|
        shots = (loc.get_app_screenshot_sets rescue [])
        UI.message("  locale=#{loc.locale} desc=#{loc.description.to_s.length}ch kw=#{loc.keywords.to_s.length}ch support=#{loc.support_url.inspect} screenshot_sets=#{shots.length}")
      end
      # List ALL review submissions, not just "in progress": a DRAFT created in
      # the ASC UI does not match that filter, so orphans stayed invisible while
      # still holding the version — which is what made every API submit fail
      # with "appStoreVersions ... is not in valid state" (a version can belong
      # to only ONE submission).
      begin
        all_subs = Spaceship::ConnectAPI.get_review_submissions(
          app_id: app.id, includes: "items"
        ).to_models
        UI.important("review submissions: #{all_subs.length}")
        all_subs.each do |rs|
          # Array() — `items` comes back nil (not raising) when the
          # relationship was not fetched, and nil.length crashes.
          items = Array(rs.items)
          vers = items.map { |it| (it.app_store_version&.version_string rescue nil) }.compact
          UI.message("  id=#{rs.id} state=#{rs.state} items=#{items.length} versions=#{vers.inspect}")
          if items.empty? && ENV["CLEAR_EMPTY_SUBMISSION"] == "true"
            begin
              rs.delete!
              UI.success("  → deleted EMPTY submission #{rs.id}")
            rescue => e
              UI.important("  → could not delete #{rs.id}: #{e.message[0,120]}")
            end
          end
          # Only a READY_FOR_REVIEW submission can be submitted. Guard explicitly
          # so a COMPLETE one (the already-reviewed submission) is never touched.
          if ENV["SUBMIT_EXISTING"] == "true" && !items.empty? && rs.state == "READY_FOR_REVIEW"
            begin
              rs.submit_for_review
              UI.success("  → SUBMITTED existing submission #{rs.id} for review")
            rescue => e
              UI.important("  → submit failed for #{rs.id}: #{e.message[0,200]}")
            end
          end
        end
      rescue => e
        UI.important("could not list review submissions: #{e.class}: #{e.message[0,160]}")
      end

      sub = app.get_in_progress_review_submission(platform: "IOS")
      if sub
        # Array() — `items` comes back nil (not raising) when the relationship
        # was not fetched, and nil.length crashes here.
        items = Array(sub.items)
        UI.important("in-progress review submission id=#{sub.id} state=#{sub.state} items=#{items.length}")
        if items.empty? && ENV["CLEAR_EMPTY_SUBMISSION"] == "true"
          begin
            sub.delete!
            UI.success("Deleted the EMPTY review submission (it was blocking the UI).")
          rescue => e
            UI.important("could not delete submission: #{e.message[0,160]}")
          end
        end
      else
        UI.message("no in-progress review submission")
      end
      next
    end

    target = ENV.fetch("APP_VERSION", "1.0")
    version = versions.find { |v| v.version_string == target }
    UI.user_error!("No iOS version '#{target}' found on the app") unless version
    UI.message("Target version #{target}: state=#{version.app_store_state} id=#{version.id}")

    build_num = ENV.fetch("SUBMIT_BUILD_NUMBER")
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, version: target, build_number: build_num,
    )
    build = builds.first
    UI.user_error!("Build #{target}(#{build_num}) not found in App Store Connect") unless build
    UI.message("Found build #{target}(#{build_num}) id=#{build.id} state=#{build.processing_state}")

    # Attach the build to the version (the step that can't be done in ASC
    # mobile web).
    version.select_build(build_id: build.id)
    UI.success("Attached build #{target}(#{build_num}) to version #{version.id}.")

    # App Review Information → Notes. APPEND-only: the existing notes carry the
    # hand-written "how to get in" instructions, and clobbering them would cost
    # the reviewer the very context they need. Skips silently if the text is
    # already present, so re-running is safe.
    extra = ENV["REVIEW_NOTES_APPEND"]
    if extra && !extra.strip.empty?
     begin
      # NOTE: creating a review detail fails with "Access Unavailable" when one
      # already exists, so a failed FETCH must not fall through to create.
      # fastlane 2.239 renamed the fetcher: AppStoreVersion has
      # fetch_app_store_review_detail (get_app_store_review_detail does NOT
      # exist on it — that NoMethodError is what used to break this append).
      detail = version.fetch_app_store_review_detail
      current = (detail&.notes || "")
      if current.include?(extra.strip)
        UI.message("Review notes already contain the addition — leaving as-is.")
      else
        merged = current.strip.empty? ? extra.strip : "#{current.rstrip}\n\n#{extra.strip}"
        if merged.length > 4000
          UI.user_error!("Review notes would be #{merged.length} chars (max 4000). Trim them first.")
        end
        if detail
          detail.update(attributes: { notes: merged })
        else
          version.create_app_store_review_detail(attributes: { notes: merged })
        end
        UI.success("Appended #{extra.strip.length} chars to App Review notes (now #{merged.length}).")
      end
     rescue => e
      # Never fail the job here: attaching the build is the part that cannot be
      # done from ASC mobile web, and it has already succeeded by this point.
      # Notes ARE editable on mobile, so a human can finish this in seconds.
      UI.important("Could not update App Review notes automatically (#{e.class}: #{e.message}).")
      UI.important("Paste this into App Review Information → Notes by hand:")
      UI.important(extra.strip)
     end
    end

    # Submitting is a separate, deliberate step: it is outward-facing and this
    # app is set to auto-release on approval. Default OFF so the build swap can
    # be done for someone who only has ASC mobile web (where the build picker
    # is desktop-hover-only) while the submit stays their call.
    unless ENV["SUBMIT_FOR_REVIEW"] == "true"
      UI.success("Build attached. SUBMIT_FOR_REVIEW is not 'true', so NOT submitting.")
      next
    end

    # Submit for review via the new ASC review-submission model: find an open
    # submission (or create one), add this version, then submit. Reaching the
    # 'Add for Review' button is unreliable on the ASC mobile web, so do it here.
    submission = app.get_in_progress_review_submission(platform: "IOS")
    fresh_submission = false
    if submission.nil?
      submission = app.create_review_submission(platform: "IOS")
      fresh_submission = true
      UI.message("Created review submission id=#{submission.id} state=#{submission.state}")
    elsif submission.state == Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState::UNRESOLVED_ISSUES
      # A submission in UNRESOLVED_ISSUES (the previously REJECTED item) cannot
      # take new items; submitting it again is known to fail with "Version is
      # not ready to be submitted yet". Either reset it (cancel + fresh
      # submission) or fail early with instructions — never the doomed submit.
      unless ENV["RESET_SUBMISSION"] == "true"
        UI.user_error!(
          "In-progress review submission id=#{submission.id} is in UNRESOLVED_ISSUES " \
          "(it still holds the previously rejected item). Apple rejects any " \
          "submit on it with 'Version is not ready to be submitted yet'. " \
          "Re-run this workflow with reset_submission=true to cancel it and " \
          "create a fresh submission."
        )
      end
      submission = reset_unresolved_submission!(app: app, submission: submission)
      fresh_submission = true
    else
      UI.message("Reusing in-progress review submission id=#{submission.id} state=#{submission.state}")
    end

    begin
      submission.add_app_store_version_to_review_items(app_store_version_id: version.id)
      UI.message("Added version #{version.id} to the review submission")
    rescue => e
      if fresh_submission
        UI.user_error!(
          "Could not add version #{version.id} to the freshly created review submission " \
          "id=#{submission.id} state=#{submission.state}: #{e.class}: #{e.message[0, 300]}. " \
          "Not submitting an empty submission."
        )
      end
      UI.important("add_app_store_version_to_review_items: #{e.message} (may already be included)")
    end

    submission.submit_for_review
    UI.success("Submitted version #{target}(#{build_num}) for App Review.")
  end
end
