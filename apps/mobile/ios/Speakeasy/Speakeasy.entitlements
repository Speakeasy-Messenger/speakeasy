<?xml version="1.0" encoding="UTF-8"?>
<!--
  App entitlements for the Speakeasy target.

  Wired into the project via CODE_SIGN_ENTITLEMENTS (Debug + Release) by
  tools/wire-ios-project.rb. Counterpart of Android's push + App-Links setup.

  aps-environment = production: the only fastlane match profile is the
  App Store *distribution* profile (Matchfile type "appstore"), and TestFlight
  + App Store both use the production APNs environment. Without this key a
  signed build cannot register with APNs, so @react-native-firebase/messaging
  getToken() never resolves an APNs token and push never arrives. (If a
  `development` match type is ever added for on-device debug builds, pair it
  with a Debug-config entitlements file carrying aps-environment=development.)

  associated-domains: enables Universal Links for https://speakeasyapp.xyz/add
  so a tapped add-handle / QR link opens the app directly (parity with
  Android's autoVerify App Links intent-filter). Requires the AASA file hosted
  at https://speakeasyapp.xyz/.well-known/apple-app-site-association and the
  domain enabled on the provisioning profile.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>aps-environment</key>
  <string>production</string>
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:speakeasyapp.xyz</string>
  </array>
  <!-- Shared container with the Share Extension. ShareViewController writes
       the shared text here; ShareReceiveModule reads it on next foreground.
       Must match ShareExtension.entitlements + both bundle IDs' profiles. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.xyz.speakeasyapp.app</string>
  </array>
  <!-- REMOVED 2026-08-07 — com.apple.developer.avfoundation.multitasking-camera-access.
       It keeps the local camera capturing while backgrounded during a video call
       (otherwise the peer sees a frozen frame), but Apple REQUIRES a `voip` entry
       in UIBackgroundModes for it: altool rejects the upload with error 91124,
       "This app has the … multitasking-camera-access entitlement, so the
       UIBackgroundModes Info.plist key must contain a voip entry."

       We removed `voip` the same day to clear the Guideline 2.5.4 rejection
       (VoIP background mode declared with no CallKit/PushKit service behind it),
       and our reply to App Review states that removal — so re-adding `voip` now
       would both re-trigger 2.5.4 and make that answer untrue.

       Restore this TOGETHER with `voip` in the same PR that enables CallKit
       (orchestrator.ts CALLKEEP_ENABLED), which is what legitimately justifies
       the VoIP background mode. Until then, backgrounding a video call freezes
       YOUR outgoing video for the peer; receiving their video in PiP is
       unaffected. Note this entitlement has never shipped in a production build
       — it existed only on the branch line — so this is not a user regression. -->
</dict>
</plist>
